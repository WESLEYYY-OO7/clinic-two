generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(STARTER)
  createdAt DateTime @default(now())

  users          User[]
  patients       Patient[]
  encounters     Encounter[]
  invoices       Invoice[]
  appointments   Appointment[]
  auditLogs      AuditLog[]
  drugs          Drug[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  labTests       LabTest[]
  employees      Employee[]
  claims         Claim[]
  items          Item[]
  stockLocations StockLocation[]
  stockBatches   StockBatch[]
  stockMovements StockMovement[]
}

enum Plan {
  STARTER
  STANDARD
  ENTERPRISE
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean   @default(true)
  phone        String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  LAB_TECH
  RECEPTIONIST
  BILLING
  HR
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  beforeState  Json?
  afterState   Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, resourceType, resourceId])
  @@index([createdAt])
}

model Patient {
  id           String   @id @default(uuid())
  tenantId     String
  mrn          String
  firstName    String
  middleName   String?
  lastName     String
  dateOfBirth  DateTime
  gender       Gender
  phone        String?
  email        String?
  address      String?
  bloodGroup   String?
  allergies    Json?
  nextOfKin    Json?
  fhirResource Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  encounters   Encounter[]
  invoices     Invoice[]
  appointments Appointment[]

  @@unique([tenantId, mrn])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, phone])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

model Encounter {
  id           String          @id @default(uuid())
  tenantId     String
  patientId    String
  providerId   String
  type         EncounterType
  status       EncounterStatus @default(PLANNED)
  reason       String?
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  fhirResource Json?

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  patient   Patient        @relation(fields: [patientId], references: [id])
  notes     ClinicalNote[]
  vitals    Vital[]
  diagnoses Diagnosis[]
  labOrders LabOrder[]

  @@index([tenantId, patientId])
  @@index([tenantId, status])
}

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  TELEMEDICINE
}

enum EncounterStatus {
  PLANNED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model ClinicalNote {
  id          String   @id @default(uuid())
  tenantId    String
  encounterId String
  authorId    String
  content     String
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([tenantId, encounterId])
}

model Vital {
  id           String   @id @default(uuid())
  tenantId     String
  encounterId  String
  recordedAt   DateTime @default(now())
  temperatureC Float?
  heartRateBpm Int?
  respRateBpm  Int?
  bpSystolic   Int?
  bpDiastolic  Int?
  spo2         Int?
  weightKg     Float?
  heightCm     Float?
  bmi          Float?

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([tenantId, encounterId])
}

model Diagnosis {
  id          String   @id @default(uuid())
  tenantId    String
  encounterId String
  code        String
  display     String
  certainty   String?
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([tenantId, code])
}

model Invoice {
  id        String        @id @default(uuid())
  tenantId  String
  patientId String
  number    String
  status    InvoiceStatus @default(DRAFT)
  subtotal  Decimal       @db.Decimal(12, 2)
  tax       Decimal       @db.Decimal(12, 2) @default(0)
  discount  Decimal       @db.Decimal(12, 2) @default(0)
  total     Decimal       @db.Decimal(12, 2)
  balance   Decimal       @db.Decimal(12, 2)
  issuedAt  DateTime?
  dueAt     DateTime?
  createdAt DateTime      @default(now())

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  patient   Patient           @relation(fields: [patientId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id         String        @id @default(uuid())
  tenantId   String
  invoiceId  String
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  reference  String?
  receivedAt DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, invoiceId])
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
  HMO
  CARD
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  patientId       String
  providerId      String
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?
  notes           String?
  reminderSentAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, startsAt])
  @@index([tenantId, patientId])
  @@index([tenantId, providerId])
  @@index([tenantId, status])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model Drug {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  genericName String?
  form        String?
  strength    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  prescriptions Prescription[]

  @@index([tenantId, name])
}

model Prescription {
  id           String             @id @default(uuid())
  tenantId     String
  encounterId  String?
  patientId    String
  drugId       String
  dose         String
  frequency    String
  durationDays Int
  status       PrescriptionStatus @default(PENDING)
  createdAt    DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  drug   Drug   @relation(fields: [drugId], references: [id])

  @@index([tenantId, patientId])
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}

model LabTest {
  id             String   @id @default(uuid())
  tenantId       String
  code           String
  name           String
  specimen       String
  unit           String
  referenceRange String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model LabOrder {
  id           String         @id @default(uuid())
  tenantId     String
  encounterId  String
  patientId    String
  testId       String
  status       LabOrderStatus @default(ORDERED)
  resultValue  String?
  resultFlag   String?
  resultedAt   DateTime?
  resultedById String?
  notes        String?
  fhirResource Json?
  createdAt    DateTime       @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, patientId])
}

enum LabOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Employee {
  id         String   @id @default(uuid())
  tenantId   String
  fullName   String
  email      String?
  phone      String?
  role       String
  hiredAt    DateTime @default(now())
  salaryBase Decimal  @db.Decimal(12, 2)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Claim {
  id          String      @id @default(uuid())
  tenantId    String
  patientId   String
  hmo         String
  amount      Decimal     @db.Decimal(12, 2)
  status      ClaimStatus @default(DRAFT)
  submittedAt DateTime?
  resolvedAt  DateTime?
  notes       String?
  createdAt   DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  PAID
}

// ─────────────────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────────────────

model Item {
  id           String       @id @default(uuid())
  tenantId     String
  code         String
  name         String
  category     ItemCategory
  unit         ItemUnit
  reorderLevel Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  batches   StockBatch[]
  movements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
}

enum ItemCategory {
  DRUG
  INJECTION
  CONSUMABLE
  EQUIPMENT
  REAGENT
}

enum ItemUnit {
  TABLET
  CAPSULE
  VIAL
  AMPOULE
  BOTTLE
  BOX
  SACHET
  PIECE
  PAIR
  SET
}

model StockLocation {
  id        String            @id @default(uuid())
  tenantId  String
  name      String
  type      StockLocationType
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  batches   StockBatch[]
  movements StockMovement[]

  @@index([tenantId, type])
}

enum StockLocationType {
  STORE
  PHARMACY
  WARD
  THEATRE
  LAB
}

model StockBatch {
  id          String   @id @default(uuid())
  tenantId    String
  itemId      String
  locationId  String
  batchNumber String
  expiryDate  DateTime
  quantity    Int      @default(0)
  costPrice   Decimal  @db.Decimal(12, 2) @default(0)
  supplier    String?
  createdAt   DateTime @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  item      Item            @relation(fields: [itemId], references: [id])
  location  StockLocation   @relation(fields: [locationId], references: [id])
  movements StockMovement[]

  @@unique([tenantId, itemId, locationId, batchNumber])
  @@index([tenantId, itemId])
  @@index([tenantId, expiryDate])
}

model StockMovement {
  id            String             @id @default(uuid())
  tenantId      String
  itemId        String
  batchId       String?
  locationId    String
  type          StockMovementType
  quantity      Int
  referenceType String?
  referenceId   String?
  reason        String?
  performedById String?
  createdAt     DateTime           @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  item      Item          @relation(fields: [itemId], references: [id])
  batch     StockBatch?   @relation(fields: [batchId], references: [id])
  location  StockLocation @relation(fields: [locationId], references: [id])

  @@index([tenantId, itemId])
  @@index([tenantId, locationId])
  @@index([tenantId, createdAt])
}

enum StockMovementType {
  RECEIVE
  DISPENSE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUST_IN
  ADJUST_OUT
  EXPIRE
  RETURN
}