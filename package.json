{
    "name":  "clinic-two",
    "private":  true,
    "version":  "0.1.0",
    "packageManager":  "pnpm@9.0.0",
    "scripts":  {
                    "dev":  "turbo run dev",
                    "build":  "turbo run build",
                    "lint":  "turbo run lint",
                    "test":  "turbo run test",
                    "db:generate":  "pnpm --filter @cura/db-client exec prisma generate",
                    "db:migrate":  "pnpm --filter @cura/db-client exec prisma migrate dev",
                    "db:seed":  "pnpm --filter @cura/db-client exec tsx prisma/seed.ts",
                    "db:studio":  "pnpm --filter @cura/db-client exec prisma studio"
                },
    "devDependencies":  {
                            "turbo":  "^2.0.0",
                            "typescript":  "^5.5.0"
                        }
}